# n8n Environment Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=super-secret-enterprise-encryption-key-32chars
NODE_ENV=development
N8N_COMMUNITY_PACKAGES_ENABLED=true

# Database (PostgreSQL with pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secret

# Vector Store (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# Local MailHog (SMTP & Web Inspection)
SMTP_HOST=mailhog
SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# AI Providers (Default points to local mock-services; replace with real keys for production)
OPENAI_API_BASE=http://mock-services:4000/v1
OPENAI_API_KEY=local-dev-mock-key
ANTHROPIC_API_KEY=

# Slack Integration (Default points to local mock-services; replace with real Slack webhook)
SLACK_WEBHOOK_URL=http://mock-services:4000/slack/webhook
SLACK_SIGNING_SECRET=sample_slack_signing_secret_12345

# Mock Simulation Service
MOCK_SERVICES_PORT=4000
